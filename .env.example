# Copy to ".env" (git-ignored) and fill in. Never commit real values.

# The web app needs no environment variables: it uses an open demo login and
# keeps its data in the browser. Everything below is for the optional API
# server in server/, which the web app does not call.

# ---- API server (npm run server) ----------------------------------------
# The same Firebase project id (used to verify Firebase ID tokens).
ECOSETU_FIREBASE_PROJECT_ID=

# MongoDB Atlas connection string and database name.
MONGODB_URI=
MONGODB_DB_NAME=

# Secrets for the app's own session tokens. Use two different random strings
# of at least 32 characters, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ECOSETU_JWT_SECRET=
ECOSETU_JWT_REFRESH_SECRET=

# ---- Demo roles (npm run seed-demo-roles) -------------------------------
# Your three Firebase test phone numbers (10 digits). Optional.
DEMO_CITIZEN_PHONE=
DEMO_WORKER_PHONE=
DEMO_GOVERNMENT_PHONE=
