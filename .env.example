# Copy to .env (or .env.local for Vite-only values) and fill in. Never commit the filled-in file.

# ---- Web app (Vite; public Firebase web config for phone OTP login) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# true: sign in through the API below (server tokens, roles from the database).
# Leave unset for the browser-only demo build that needs no server.
VITE_USE_API=

# ---- API server (npm run server locally; the same names in Vercel's project settings) ----
MONGODB_URI=
MONGODB_DB_NAME=ecosetu
ECOSETU_FIREBASE_PROJECT_ID=
# Three different random secrets, at least 32 characters each. In production
# (NODE_ENV=production or any Vercel deployment) the server refuses to start
# if one is missing or short. (JWT_ACCESS_SECRET / JWT_REFRESH_SECRET also work.)
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ECOSETU_JWT_SECRET=
ECOSETU_JWT_REFRESH_SECRET=
PHONE_HASH_SECRET=
# true: enable POST /api/auth/demo (the labelled demo login). Off otherwise.
DEMO_LOGIN_ENABLED=

# Photos: a PRIVATE Vercel Blob store. On Vercel, connect the store to the
# project (Storage > Blob > access: Private); that provides BLOB_STORE_ID and
# credentials automatically. Locally (vercel env pull) or off Vercel, set:
BLOB_READ_WRITE_TOKEN=
# Any random string of 16+ characters; Vercel Cron sends it to the daily
# job that retries photo deletes that failed.
CRON_SECRET=
