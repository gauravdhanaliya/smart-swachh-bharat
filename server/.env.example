# Server settings live in the project-root ".env" (git-ignored); see ../.env.example
# for the required keys:
#   MONGODB_URI, MONGODB_DB_NAME, ECOSETU_JWT_SECRET, ECOSETU_JWT_REFRESH_SECRET,
#   ECOSETU_FIREBASE_PROJECT_ID
#
# Optional:
# PORT=4000
# ECOSETU_CORS_ORIGINS=               # comma-separated frontend origins when the API is on another origin
# ECOSETU_AUTH_RATE_MAX=30            # /api/auth requests per IP per window
# ECOSETU_SEED_DEMO=false             # skip simulated demo locations
