# Server settings live in the project-root ".env" (git-ignored); see ../.env.example
# for the required keys:
#   MONGODB_URI, MONGODB_DB_NAME, ECOSETU_JWT_SECRET, ECOSETU_JWT_REFRESH_SECRET,
#   PHONE_HASH_SECRET, ECOSETU_FIREBASE_PROJECT_ID
#
# Optional (the values shown are the defaults):
# PORT=4000
# ECOSETU_CORS_ORIGINS=               # comma-separated frontend origins when the API is on another origin
# ECOSETU_AUTH_RATE_MAX=120           # sign-in requests per IP per window (ECOSETU_AUTH_RATE_WINDOW_MS, default 60000)
# ECOSETU_LOGIN_FAIL_MAX=30           # failed sign-ins (bad or forged Firebase tokens) per IP before a 429 (ECOSETU_LOGIN_FAIL_WINDOW_MS, default 600000)
# ECOSETU_SEED_DEMO=false             # skip simulated demo locations and demo users
# DEMO_LOGIN_ENABLED=true             # enable POST /api/auth/demo (off unless exactly "true")
# ECOSETU_COMPLAINT_RATE_MAX=10       # new complaints per user per window (ECOSETU_COMPLAINT_RATE_WINDOW_MS, default 1 hour)
# ECOSETU_COMPLAINT_IP_RATE_MAX=30    # new complaints per IP per window (same window)
# ECOSETU_SIGNUP_RATE_MAX=20          # new accounts (first sign-in) per IP per window (ECOSETU_SIGNUP_RATE_WINDOW_MS, default 1 hour)
# ECOSETU_RATING_RATE_MAX=20          # toilet ratings set or changed per user per window (ECOSETU_RATING_RATE_WINDOW_MS, default 1 hour)
# ECOSETU_RATING_IP_RATE_MAX=60       # ...and per IP (same window)
# ECOSETU_VOTE_RATE_MAX=60            # complaint votes set, changed or removed per user per window (ECOSETU_VOTE_RATE_WINDOW_MS, default 1 hour)
# ECOSETU_VOTE_IP_RATE_MAX=200        # ...and per IP (same window)
# ECOSETU_CONSENT_VERSION=1           # raise when the privacy notice changes: everyone is asked again
# ECOSETU_MAP_LIMIT=2000              # most facilities GET /api/locations/map returns (1-2000)
# ECOSETU_WRITE_RATE_MAX=60           # writes (POST/PUT/PATCH/DELETE) per signed-in user per window (ECOSETU_WRITE_RATE_WINDOW_MS, default 60000)
# ECOSETU_BLOB_FAKE_DIR=              # tests only: a local folder instead of Vercel Blob (refused in production)
# ECOSETU_DEMO_RATE_MAX=60            # demo logins per IP per window (ECOSETU_DEMO_RATE_WINDOW_MS, default 60000)
# ECOSETU_GEO_RATE_MAX=30             # place searches / address lookups per user per window (ECOSETU_GEO_RATE_WINDOW_MS, default 60000)
# ECOSETU_GEOCODE_USER_AGENT=         # User-Agent sent to Nominatim (default "EcoSetu/1.0 (+https://smart-swachh-bharat.vercel.app)")
