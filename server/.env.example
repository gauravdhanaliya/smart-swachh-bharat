# Copy to the project root as ".env" (it is git-ignored) and fill in real values.
# Required in production; in development the server falls back to insecure
# defaults and prints a warning.

ECOSETU_JWT_SECRET=change-me-to-a-long-random-string
ECOSETU_CODE_WORKER=change-me
ECOSETU_CODE_SUPERVISOR=change-me
ECOSETU_CODE_OFFICIAL=change-me
ECOSETU_CODE_SUPERADMIN=change-me

# Optional
# ECOSETU_REQUIRE_ACCESS_CODES=true   # off by default: every role logs in with mobile + OTP only
# PORT=4000
# ECOSETU_DB_PATH=server/data/ecosetu.db
# ECOSETU_CORS_ORIGINS=https://your-frontend.example.com
# ECOSETU_SEED_DEMO=false      # skip simulated demo locations
